{
  "name": "ailoop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "up": "bash scripts/prod.sh",
    "ailoop": "bun run scripts/ailoop.ts",
    "run": "bun run scripts/ailoop.ts run",
    "start": "bun run scripts/ailoop.ts start",
    "stop": "bun run scripts/ailoop.ts stop",
    "pause": "bun run scripts/ailoop.ts pause",
    "resume": "bun run scripts/ailoop.ts resume",
    "status": "bun run scripts/ailoop.ts status",
    "watch": "bun run scripts/ailoop.ts watch",
    "server": "bun run src/server.ts",
    "typecheck": "tsc --noEmit",
    "web:dev": "bun --cwd=web run dev",
    "web:build": "bun --cwd=web run build",
    "web:preview": "bun --cwd=web run preview"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/bun": "latest"
  }
}
